{
  "name": "tirgeo-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Australian civil construction operations platform backend",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "frontend:install": "npm --prefix frontend ci",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:stage": "node scripts/stage-frontend-for-vercel.mjs",
    "vercel-build": "npm run frontend:install && npm run frontend:build && npm run frontend:stage && prisma generate && tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "test": "vitest run",
    "lint": "eslint api src tests",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:company": "tsx prisma/seed-company.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/swagger": "^9.5.0",
    "@fastify/swagger-ui": "^5.2.0",
    "@prisma/client": "^6.10.0",
    "@vercel/blob": "^2.6.1",
    "bcrypt": "^6.0.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.4.0",
    "fastify-plugin": "^5.0.0",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^24.0.0",
    "eslint": "^9.30.0",
    "prisma": "^6.10.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
